# Generated by fmverify.
#
# The solver package is fetched and hash-verified by fetch-solver.sh / fetch-solver.ps1
# rather than committed: it is ~65 MB, and a pinned version plus a pinned hash already give
# reproducibility without putting a binary in your history. If you build somewhere with no
# access to github.com, commit .packages/ instead and delete this line.
.packages/

# The unbounded engine, for a layer that opted into it: fetched and hash-verified by
# fetch-dafny.sh / fetch-dafny.ps1 for the same reasons as the solver.
.tools/

bin/
obj/

# Written by the gate on every run and printed by verify.sh, so a committed copy would go stale
# silently — and it is a report about one run rather than a fact about the layer.
bridge-coverage.txt

# Per-method symbolic outcomes from the same run: the JSON feeds the audit, the text is what
# verify.sh prints. Both are reports about one run, not facts about the layer.
symbolic-coverage.json
symbolic-coverage.txt

# Generated on every prove run; uploaded by CI rather than committed.
translation/repro/
translation/fmverify-results.sarif
