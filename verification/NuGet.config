<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Scaffold package sources.

    Microsoft.Z3 is not restorable from nuget.org: publishing there stopped at 4.12.2 in
    2023, and every release since ships its .nupkg only as a GitHub release asset. A release
    page is not a NuGet feed, so fetch-solver.sh / fetch-solver.ps1 puts the package into
    .packages/ and this file makes restore look there.

    This ADDS a source and never discards the ones you already have. NuGet.config files
    merge from the directory upward, so your own feeds still apply to these projects. Your
    feed policy is yours — fmverify only adds what it must to restore its own solver.
  -->

  <packageSources>
    <add key="fmverify-solver" value=".packages" />
  </packageSources>

</configuration>
